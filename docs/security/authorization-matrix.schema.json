{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinx.dev/schemas/authorization-matrix.schema.json",
  "title": "CINX authorization matrix",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "defaults",
    "authorityMapping",
    "operations",
    "releaseChecks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "retired"
      ]
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "owners": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "defaults": {
      "type": "object",
      "required": [
        "decision",
        "principalClaim",
        "missingAttributeDecision"
      ]
    },
    "routeEncoding": {
      "type": "object"
    },
    "authorityMapping": {
      "type": "object",
      "required": [
        "roles",
        "permissions",
        "oauthScopes"
      ]
    },
    "policyCheckTypes": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "releaseChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "permission": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "route": {
      "type": "object",
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)(\\|(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS))*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "conditional"
            }
          ]
        },
        "tokenKind": {
          "enum": [
            "user",
            "service"
          ]
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedClients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mfaRequired": {
          "type": "boolean"
        },
        "mechanism": {
          "type": "string"
        },
        "rawBodyRequired": {
          "type": "boolean"
        },
        "timestampAndReplayWindowRequired": {
          "type": "boolean"
        },
        "providerAllowlistRequired": {
          "type": "boolean"
        },
        "credentialLocation": {
          "type": "string"
        },
        "requiredClaims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "uidMayBeAbsent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "relationship",
        "attributes",
        "entitlement",
        "quota"
      ],
      "properties": {
        "permissionsAll": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          },
          "uniqueItems": true
        },
        "permissionsAny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "relationship": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entitlement": {
          "type": [
            "object",
            "null"
          ]
        },
        "quota": {
          "type": [
            "object",
            "null"
          ]
        },
        "entitlementFailureCode": {
          "type": "string"
        },
        "quotaFailureCode": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "permissionsAll"
          ],
          "not": {
            "required": [
              "permissionsAny"
            ]
          }
        },
        {
          "required": [
            "permissionsAny"
          ],
          "not": {
            "required": [
              "permissionsAll"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "transport",
        "exposure",
        "authentication",
        "authorization",
        "audit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "owner": {
          "enum": [
            "auth",
            "user",
            "commerce",
            "learning",
            "recommendation",
            "notification",
            "reporting",
            "assistant"
          ]
        },
        "transport": {
          "enum": [
            "http",
            "http-sse",
            "websocket-stomp"
          ]
        },
        "exposure": {
          "enum": [
            "public",
            "user",
            "internal",
            "provider"
          ]
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "destinations": {
          "type": "object"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "idempotency": {
          "type": "object"
        },
        "concealUnauthorizedResource": {
          "type": "boolean"
        },
        "audit": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "routes"
          ],
          "not": {
            "required": [
              "destinations"
            ]
          }
        },
        {
          "required": [
            "destinations"
          ],
          "not": {
            "required": [
              "routes"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
