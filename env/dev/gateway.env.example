KEYCLOAK_BASE_URL=http://keycloak:8080
RECOMMENDATION_HOST=recommendation
RECOMMENDATION_PORT=8090
CORS_ALLOWED_ORIGINS=https://dev-frontend.example.com
AUTH_INTERNAL_BASE_URL=http://auth:8888
KEYCLOAK_SERVICE_TOKEN_URI=http://keycloak:8080/realms/cinx/protocol/openid-connect/token
CINX_GATEWAY_SERVICE_CLIENT_SECRET=replace-me
# Search rate limit (P1-01): Redis for the counters, and the HMAC key that keeps raw guest IPs out of them
REDIS_HOST=redis
REDIS_PORT=6379
GATEWAY_RATE_LIMIT_KEY=replace-me-with-a-long-random-value
# true only behind a proxy that sets X-Forwarded-For; otherwise a client could pick its own counter
GATEWAY_TRUST_FORWARDED_FOR=false
