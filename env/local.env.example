# Read by services run on the host with the local profile (Spring and Python). Plain KEY=value only: no quotes, no export.
MYSQL_ROOT_PASSWORD=replace-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=cinx
RABBITMQ_PASSWORD=replace-me
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me
CINX_GATEWAY_SERVICE_CLIENT_SECRET=replace-me
GATEWAY_RATE_LIMIT_KEY=replace-me-with-a-long-random-value
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
AWS_ACCESS_KEY=replace-me
AWS_SECRET_KEY=replace-me
