# Module-only values; secrets shared with the Java services come from ../env/local.env. This file overrides it.
DB_HOST=localhost
DB_PORT=3300
DB_NAME=recommendationdb
DB_USER=root
DB_PASSWORD=replace-me
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DIGITALOCEAN_LLM_MODEL=replace-me
DIGITALOCEAN_LLM_TIMEOUT_SECONDS=60
